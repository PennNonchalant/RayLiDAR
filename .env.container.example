# Copy to .env.container and replace <IMAGE> with the approved project image.
# Never put credentials or tokens in .env.container or this template.
RAYLIDAR_CONTAINER_RUN_CMD="docker run --rm --user 0:0 --gpus all -v /home/hj/Hybrid-lidar-sim:/src -v /data-20T/hybrid-lidar-sim:/work -v /data-20T:/data-20T -w /src -e VCPKG_ROOT=/work/vcpkg <IMAGE>"
RAYLIDAR_CONTAINER_WORKDIR=/src
RAYLIDAR_PRESET=linux-debug
RAYLIDAR_ARTIFACTS_ROOT=/data-20T/hybrid-lidar-sim/artifacts
